// The legacy city builder (v0.2.1, before isometrica became a monorepo), frozen on the `legacy` branch.
// A static site on Cloudflare Workers: `npm run build` → dist/, served as static assets (no Worker script).
// Deployed by .github/workflows/deploy.yml on push to `legacy`: Worker "legacy" (legacy.peeps.land).
//
// workers_dev / preview_urls / routes are set explicitly so a deploy never flips what's set in the dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legacy",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "legacy.peeps.land", "custom_domain": true }],
}

{
  "name": "isometrica-monorepo",
  "version": "0.2.1",
  "description": "Games played in one isometric world: the world (isometrica), the engine it is drawn with, and the games - city-sim and food-rider",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "engine",
    "engine/*",
    "isometrica",
    "city-sim",
    "food-rider"
  ],
  "scripts": {
    "dev:city-sim": "npm run dev -w city-sim",
    "dev:food-rider": "npm run dev -w food-rider",
    "dev:isometrica": "npm run dev -w isometrica",
    "build": "npm run build -w city-sim && npm run build -w food-rider",
    "build:city-sim": "npm run build -w city-sim",
    "build:food-rider": "npm run build -w food-rider",
    "build:lab": "npm run build:lab -w isometrica",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}

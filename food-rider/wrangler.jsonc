// The delivery game, a static site on Cloudflare Workers: `npm run build` here → dist/, served as static assets (no Worker script).
// Deployed by .github/workflows/food-rider.yml. No domain of its own yet: it is on the account's workers.dev subdomain.
//
// Top level is the "food-rider-dev" Worker:
//   push to develop      → `wrangler deploy --env=`
//   push to other branch → `wrangler preview --env= --name <branch>` → https://<branch>-food-rider-dev.<subdomain>.workers.dev
// env.production is the "food-rider" Worker:
//   push to main         → `wrangler deploy --env production`
//
// workers_dev / preview_urls are set explicitly so a deploy never flips what's set in the dashboard.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "food-rider-dev",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
  },
  "workers_dev": true,
  // `wrangler preview` URLs live on workers.dev and need this on.
  "preview_urls": true,
  // `wrangler preview` refuses to run without this block; empty means Previews reuse the settings above.
  "previews": {},
  "env": {
    "production": {
      "name": "food-rider",
      "workers_dev": true,
      "preview_urls": false,
    },
  },
}
